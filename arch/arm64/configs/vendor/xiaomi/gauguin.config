# OEM Power drivers
CONFIG_BATT_VERIFY_BY_DS28E16=y
CONFIG_BQ2597X_CHARGE_PUMP=y
CONFIG_SERIAL_MSM_GENI_CONSOLE=y
CONFIG_FASTBOOT_CMD_CTRL_UART=y
CONFIG_ONEWIRE_GPIO=y

# Touchscreen driver
CONFIG_TOUCHSCREEN_NT36xxx_HOSTDL_SPI=y

# Fingerprint drivers
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_GOODIX=y

# Haptic driver
CONFIG_INPUT_AW8624_HAPTIC=y

# ION
CONFIG_ION_SYSTEM_HEAP=y

# Log
CONFIG_LOG_BUF_SHIFT=20

# Netlabel
CONFIG_NETLABEL=y

# PStore configs
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# QCACLD
CONFIG_QCA_CLD_WLAN=y

# RmNet
CONFIG_RMNET_PERF=y
CONFIG_RMNET_SHS=y

# IR drivers
CONFIG_RC_CORE=y
CONFIG_LIRC=y
CONFIG_RC_DECODERS=y
CONFIG_RC_DEVICES=y
CONFIG_IR_SPI=y

CONFIG_IP_NF_TARGET_TTL=y

# exFAT
CONFIG_EXFAT_FS=y

# Unicode
# CONFIG_SDCARD_FS is not set
CONFIG_UNICODE=y


# Coresight?
CONFIG_STM=y

# Cmdline
CONFIG_CMDLINE="cgroup_disable=pressure,memory ramoops_memreserve=4M"

# RD
CONFIG_RD_LZ4=y
